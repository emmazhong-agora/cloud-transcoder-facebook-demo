# Copy to .env and fill in your own credentials. Never commit .env.
AGORA_APP_ID=
# Agora Console REST credentials, not your App Certificate.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Optional: required only for the Meta API buttons.
# Personal profile: set META_USER_ACCESS_TOKEN; leave Page fields empty.
# Facebook Page: change the target to page and set the Page token and ID.
META_TARGET_TYPE=profile
META_USER_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_GRAPH_VERSION=v26.0
PORT=8787
